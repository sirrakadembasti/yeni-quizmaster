# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
dist/
client/dist/
server/dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# Prisma & Data
/server/prisma/dev.db
/server/prisma/dev.db-journal
