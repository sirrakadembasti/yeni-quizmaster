/server/data/*.db-journal
/server/data/deployment-config.json
/server/data/deployment-config.json.tmp
/server/data/installation.lock
/server/data/setup-artifacts/
/server/backups/*
!/server/backups/README.md

# File Uploads
/server/uploads/*
!/server/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

