{
  "name": "quiz-master-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Quiz Master Backend API",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "tsx watch --exclude \"../node_modules/**\" --exclude \"node_modules/**\" index.ts",
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --outfile=../dist/index.cjs --external:sqlite3",
    "start": "cross-env NODE_ENV=production node ../dist/index.cjs",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:create-admin": "tsx prisma/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.5",
    "csrf-sync": "^4.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.10.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/connect-sqlite3": "^0.9.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.1.0",
    "esbuild": "^0.20.1",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
