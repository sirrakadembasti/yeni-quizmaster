{
  "name": "quiz-master-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Quiz Master Backend API",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "tsx watch --exclude \"../node_modules/**\" --exclude \"node_modules/**\" index.ts",
    "setup": "tsx setup-wizard/server.ts",
    "setup:cli": "tsx setup-wizard/cli.ts",
    "build": "node ../scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node ../dist/index.cjs",
    "postinstall": "prisma generate",
    "archive:prepare": "playwright install chromium",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "db:reset-admin": "tsx prisma/reset-admin.ts",
    "db:prepare-demo": "tsx prisma/prepare-demo-db.ts",
    "dev:demo": "cross-env APP_DEMO_MODE=true APP_BASE_PATH=/demo DATABASE_URL=file:../data/demo.db PORT=5001 tsx watch --exclude \"../node_modules/**\" --exclude \"node_modules/**\" index.ts",
    "start:demo": "cross-env NODE_ENV=production APP_DEMO_MODE=true APP_BASE_PATH=/demo DATABASE_URL=file:../data/demo.db PORT=5001 node ../dist/index.cjs",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "better-sqlite3": "12.8.0",
    "bcryptjs": "^3.0.3",
    "connect-sqlite3": "^0.9.18",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "prisma": "6.19.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-sqlite3": "^0.9.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.4",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
