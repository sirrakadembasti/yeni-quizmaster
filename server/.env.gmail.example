# QuizMaster Gmail SMTP template
# 1. Google account: enable 2-Step Verification.
# 2. Create an App Password; do not use the normal Gmail password.
# 3. Copy these values to server/.env and replace the placeholders.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=your-smtp-email@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM=your-smtp-email@gmail.com
EMAIL_FROM_NAME=QuizMaster
FRONTEND_URL=http://localhost:5173
