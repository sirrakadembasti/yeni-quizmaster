# Database Configuration
DATABASE_FILE=./quiz.db

# Session Configuration (Required)
# Generate a strong random string for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Environment
NODE_ENV=development

# AI Configuration (Optional)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your frontend URL(s)
# Example: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Users Configuration
# Set to 'true' to create demo users on startup
# WARNING: Only enable in development! Demo users have known passwords.
# Demo credentials when enabled:
#   admin@demo.com / admin
#   egitmen@egitmen.com / egitmen
#   ogrenci@ogrenci.com / ogrenci
CREATE_DEMO_USERS=false

# Server Configuration (Optional)
PORT=5000
