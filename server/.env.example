# Database Configuration
DATABASE_URL="file:../data/quiz.db"
# PostgreSQL geçişi için aşağıdaki formatı kullanın ve schema.prisma dosyasında provider="postgresql" yapın:
# DATABASE_URL="postgresql://kullanici_adi:sifre@localhost:5432/veritabani_adi?schema=public"

# Session Configuration (Required)
# Generate a strong random string for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Environment
NODE_ENV=development

# AI Configuration (Optional)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your frontend URL(s)
# Example: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Users Configuration
# You can populate the database with demo users by running `pnpm run db:seed`
# Demo credentials created by the seed script:
#   Admin:   admin@quizmaster.com
#   Teacher: teacher@quizmaster.com
#   Student: student@quizmaster.com
#   Password for all: QuizMaster2026!

# Server Configuration (Optional)
PORT=5000

# Email Configuration
# Local Mailpit example:
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1026
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=
#
# Gmail example (requires Google 2-Step Verification + App Password):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=your-smtp-email@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM=your-smtp-email@gmail.com
EMAIL_FROM_NAME=QuizMaster
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_SOCKET_TIMEOUT=20000
FRONTEND_URL=http://localhost:5173
