# QuizMaster Canlı Demo İkinci Kopya (domain/demo) Yapılandırma Örneği
# Bu dosyayı ikinci kopya için server/.env.demo veya demo kopyasının server/.env dosyası olarak kullanabilirsiniz.

NODE_ENV=production
PORT=5001
HOST=127.0.0.1

# Demo modunu ve /demo alt yolunu etkinleştirir (Salt-okunur vitrin koruması)
APP_DEMO_MODE=true
APP_BASE_PATH=/demo

# Ana veritabanından (quiz.db) bağımsız ayrı demo veritabanı
DATABASE_URL="file:../data/demo.db"

# Demo oturumları için benzersiz gizli anahtar (Üretimden farklı bir değer kullanın)
SESSION_SECRET="demo-instance-change-this-secret-at-least-32-chars"

# İzin verilen origin adresleri
FRONTEND_URL="http://localhost:5001"
ALLOWED_ORIGINS="http://localhost:5001,http://127.0.0.1:5001,http://localhost:5173,http://127.0.0.1:5173"
TRUST_PROXY_HOPS=1
