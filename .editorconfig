# EditorConfig - Tüm editörlerde tutarlı kodlama zorlar
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
charset = utf-8
indent_size = 2

[*.{json,jsonc}]
charset = utf-8
indent_size = 2

[*.{html,htm}]
charset = utf-8
indent_size = 2

[*.{css,scss,less}]
charset = utf-8
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
