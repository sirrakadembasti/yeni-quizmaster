# Git - Metin dosyalarının satır sonu ve encoding yönetimi
# Tüm metin dosyaları için LF kullan, BOM olmadan UTF-8

# Varsayılan: tüm dosyaları metin olarak işle
* text=auto eol=lf

# Kaynak kod dosyaları - kesinlikle LF + UTF-8
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf
*.prisma text eol=lf
*.bat   text eol=crlf
*.sh    text eol=lf

# Binary dosyalar - encoding dönüşümü yapılmamalı
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
